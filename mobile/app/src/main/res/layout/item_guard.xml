<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Avatar -->
    <androidx.cardview.widget.CardView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp">
        <LinearLayout
            android:id="@+id/layoutGuardAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/gradient_button"
            android:gravity="center">
            <TextView
                android:id="@+id/tvGuardInitial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="G"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/white" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Name + email -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvGuardName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guard Name"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_dark" />

            <!-- Status chip -->
            <TextView
                android:id="@+id/tvGuardStatusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/status_active_bg"
                android:visibility="gone" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvGuardEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="email@example.com"
            android:textSize="11sp"
            android:textColor="@color/text_light"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- Sync button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSyncThis"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:text="Sync"
        android:textSize="12sp"
        android:textColor="@color/white"
        android:background="@drawable/gradient_button"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="8dp"
        android:stateListAnimator="@null" />

</LinearLayout>